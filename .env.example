# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cle service_role : SERVEUR UNIQUEMENT. Jamais prefixee NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- App ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------- Divers ----------
# Nom affiche dans les mentions legales / la politique de confidentialite
NEXT_PUBLIC_LEGAL_ENTITY="EchoRun"
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL="lsimonin2@gmail.com"

# ---------- Fond de carte (optionnel) ----------
# Par defaut : Esri World Light Gray, clair et sans cle. Aucune variable requise.
# Pour un fond plus soigne en production, colle l'URL de tuiles fournie avec ta
# cle (MapTiler, CARTO, Stadia...) :
#   NEXT_PUBLIC_MAP_TILE_URL="https://api.maptiler.com/maps/dataviz-light/{z}/{x}/{y}.png?key=TA_CLE"
#   NEXT_PUBLIC_MAP_ATTRIBUTION="© MapTiler © OpenStreetMap"
# NEXT_PUBLIC_MAP_SUBDOMAINS=abcd   # si l'URL contient {s}
# NEXT_PUBLIC_MAP_MAX_ZOOM=19

# ---------- Routage (dessin de parcours calé sur les routes) ----------
# Par defaut : serveur de demo public OSRM, libre et sans cle. Il n'a AUCUNE
# garantie de disponibilite et interdit l'usage en production : pour lancer,
# auto-heberge une instance OSRM ou pointe vers un fournisseur, sans cle exposee
# au navigateur (ces variables sont lues cote serveur uniquement).
#   ROUTING_BASE_URL=https://router.project-osrm.org
#   ROUTING_PROFILE=foot

# ---------- E-mails transactionnels (optionnel) ----------
# Prévient le coureur quand sa course atteint le plafond de messages offerts.
# Sans clé, aucun e-mail n'est envoyé (le reste fonctionne normalement).
# RESEND_API_KEY=re_...
# EMAIL_FROM="EchoRun <bonjour@echo-run.app>"
