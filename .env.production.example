# ============================================================================
# EchoRun • variables de PRODUCTION (echo-run.app)
#
# Copie ce fichier en `.env.production` sur le serveur et remplis les valeurs.
# NE COMMITE JAMAIS `.env.production` (déjà couvert par .gitignore).
#
# Rappel : les NEXT_PUBLIC_* sont lues au BUILD (inlinées dans le bundle) ET au
# runtime. Le compose s'en occupe. Après toute modif d'un NEXT_PUBLIC_*, il faut
# REBUILD l'image (`up -d --build`), un simple restart ne suffit pas.
# ============================================================================

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://qvxyjxgsbnnfknvwadbh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : SERVEUR UNIQUEMENT. Jamais préfixée NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- App ----------
NEXT_PUBLIC_SITE_URL=https://echo-run.app

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------- Mentions légales / confidentialité ----------
NEXT_PUBLIC_LEGAL_ENTITY="EchoRun"
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL="bonjour@echo-run.app"

# ---------- Fond de carte (recommandé en production) ----------
# Par défaut (si vide) : Esri World Light Gray, sans clé • OK pour démarrer mais
# soumis à des quotas. Pour un rendu fiable, colle une URL de tuiles avec ta clé
# (MapTiler, Stadia, CARTO...) :
#   NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/dataviz-light/{z}/{x}/{y}.png?key=TA_CLE
#   NEXT_PUBLIC_MAP_ATTRIBUTION="© MapTiler © OpenStreetMap"
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
NEXT_PUBLIC_MAP_SUBDOMAINS=
NEXT_PUBLIC_MAP_MAX_ZOOM=

# ---------- Routage (dessin de parcours calé sur les routes) ----------
# Serveur OSRM. Le serveur de démo public interdit la prod : auto-héberge une
# instance ou pointe vers un fournisseur. Lu côté serveur uniquement.
# Routage du tracé à la main. Pour router sur les sentiers, utilise
# OpenRouteService (profil foot-hiking) : crée une clé gratuite sur
# openrouteservice.org puis renseigne :
ROUTING_PROVIDER=ors
ROUTING_API_KEY=
ROUTING_PROFILE=foot-hiking
# (repli sans clé : OSRM public, réseau voiture uniquement)

# ---------- E-mails transactionnels ----------
# Prévient le coureur quand sa course atteint ses 15 messages offerts.
# Sans clé, aucun e-mail n'est envoyé (le reste fonctionne). Domaine à vérifier
# dans Resend (echo-run.app).
RESEND_API_KEY=re_...
EMAIL_FROM="EchoRun <bonjour@echo-run.app>"
